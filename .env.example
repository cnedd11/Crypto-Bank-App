# Environment variable example for Crypto-Bank-App
# Copy this file to .env and fill in the values.
# Never commit the actual .env file to source control.

# Flask secret key — use a long random string in production
SECRET_KEY=your-secret-key-here

# Database URL — defaults to a local SQLite file if not set
# For PostgreSQL: ******localhost:5432/crypto_bank
DATABASE_URL=sqlite:///crypto_bank.db

# Set to "true" only during local development — NEVER in production
FLASK_DEBUG=false

# Allowed frontend origin for CORS (leave unset locally to allow all origins).
# In production set to the Render frontend URL, e.g.:
# FRONTEND_URL=https://crypto-bank-frontend.onrender.com
FRONTEND_URL=

# Backend URL used by the React frontend in production.
# Set this to the Render backend web-service URL, e.g.:
# REACT_APP_API_URL=https://crypto-bank-api.onrender.com
# Leave empty for local development (the CRA dev proxy handles /api/* routes).
REACT_APP_API_URL=
